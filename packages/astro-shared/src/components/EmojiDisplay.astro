---
type Props = {
  emojis: string[];
};

const { emojis } = Astro.props;
---

<main class="h-dvh relative overflow-hidden">
  <div id="emoji" class="absolute text-7xl select-none pointer-events-none">
  </div>
</main>

<script is:inline define:vars={{ emojis }}>
  const container = document.querySelector("main");
  const emojiEl = document.getElementById("emoji");
  let lastEmojiIndex = -1;

  const showNext = () => {
    if (!emojis?.length) return;
    let randomIndex;
    do {
      randomIndex = Math.floor(Math.random() * emojis.length);
    } while (randomIndex === lastEmojiIndex && emojis.length > 1);
    lastEmojiIndex = randomIndex;
    emojiEl.textContent = emojis[randomIndex];
  };

  showNext();

  let containerWidth = 0;
  let containerHeight = 0;
  const updateContainerSize = () => {
    containerWidth = container.clientWidth;
    containerHeight = container.clientHeight;
  };
  updateContainerSize();

  let x = 0;
  let y = 0;
  const SPEED = 240; // px per second
  const angle = Math.random() * Math.PI * 2;
  let vx = Math.cos(angle) * SPEED;
  let vy = Math.sin(angle) * SPEED;

  const clampStartPosition = () => {
    const w = emojiEl.offsetWidth;
    const h = emojiEl.offsetHeight;
    const maxX = Math.max(0, containerWidth - w);
    const maxY = Math.max(0, containerHeight - h);
    x = Math.min(Math.max(0, x), maxX);
    y = Math.min(Math.max(0, y), maxY);
  };

  requestAnimationFrame(() => {
    const w = emojiEl.offsetWidth;
    const h = emojiEl.offsetHeight;
    x = (containerWidth - w) / 2;
    y = (containerHeight - h) / 2;
    emojiEl.style.transform = `translate3d(${x}px, ${y}px, 0)`;
  });

  let lastTime = performance.now();
  const tick = (now) => {
    const dt = Math.min(0.05, (now - lastTime) / 1000);
    lastTime = now;

    x += vx * dt;
    y += vy * dt;

    const w = emojiEl.offsetWidth;
    const h = emojiEl.offsetHeight;
    const maxX = containerWidth - w;
    const maxY = containerHeight - h;

    let collided = false;

    if (x <= 0) {
      x = 0;
      vx = Math.abs(vx);
      collided = true;
    } else if (x >= maxX) {
      x = maxX;
      vx = -Math.abs(vx);
      collided = true;
    }

    if (y <= 0) {
      y = 0;
      vy = Math.abs(vy);
      collided = true;
    } else if (y >= maxY) {
      y = maxY;
      vy = -Math.abs(vy);
      collided = true;
    }

    if (collided) {
      showNext();
    }

    emojiEl.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    requestAnimationFrame(tick);
  };

  requestAnimationFrame(tick);

  const onResize = () => {
    updateContainerSize();
    clampStartPosition();
    emojiEl.style.transform = `translate3d(${x}px, ${y}px, 0)`;
  };

  window.addEventListener("resize", onResize);
</script>
