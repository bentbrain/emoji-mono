{
  "name": "emoji-mono",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "astro": "^7.2.8",
      "tailwindcss": "^4.3.1",
      "tw-animate-css": "^1.4.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:all": "turbo run build --filter=*",
    "check-types": "turbo run check-types",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "knip": "knip",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "http-cache-semantics": "^4.3.0",
    "mdast-util-to-hast": "^13.2.1",
    "postcss": "^8.5.30",
    "picomatch": "^4.0.7",
    "rollup": "^4.59.0",
    "tar": "^7.5.22",
    "source-map-js": "^1.2.2"
  }
}
