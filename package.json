{
  "name": "emoji-mono",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "astro": "^5.14.4",
      "@tailwindcss/cli": "^4.1.14",
      "tailwindcss": "^4.1.14",
      "tw-animate-css": "^1.4.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:all": "turbo run build --filter=*",
    "check-types": "turbo run check-types",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.2.9",
  "engines": {
    "node": ">=18"
  }
}
